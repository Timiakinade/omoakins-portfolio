---
import type { Testimonial } from "../lib/schema";
interface Props { items: Testimonial[]; label: string }
const { items, label } = Astro.props;
---
{items.length > 0 && (
  <section class="testimonials reveal" aria-labelledby="testimonials-label">
    <div class="l" id="testimonials-label">{label}</div>
    <div class="t-grid">
      {items.map(({ data: t }) => (
        <figure class="t-card">
          <span class="t-mark bebas" aria-hidden="true">“</span>
          <blockquote>{t.quote}</blockquote>
          <figcaption>
            <span class="t-name">{t.name}</span>
            <span class="t-role">{t.role}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
)}
