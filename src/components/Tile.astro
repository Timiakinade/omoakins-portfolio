---
/* A project tile. It carries the "featured" markup (summary, category pill) too;
   CSS shows it only when the tile has the .featured class. */
import Preview from "./Preview.astro";
import type { Project } from "../lib/content";
interface Props { project: Project; featured?: boolean; hidden?: boolean }
const { project: p, featured = false, hidden = false } = Astro.props;
const d = p.data;
---
<a
  class:list={["tile", { featured, green: d.highlight }]}
  href={`/work/${p.id}`}
  data-cat={d.category}
  data-featured={String(d.featured)}
  hidden={hidden}
>
  <div class="tile-head">
    <div class="tile-tags">
      <span class:list={["pill", { "on-green": d.highlight }]}>{d.sector}</span>
      <span class:list={["pill only-featured", { "on-green": d.highlight }]}>{d.category}</span>
    </div>
    {d.live
      ? <span class="pill live"><span class="d"></span>Live</span>
      : <span class:list={["year", { light: d.highlight }]}>{d.year}</span>}
  </div>
  {d.highlight && !d.cover ? (
    <div class="prev tall on-dark-green"><span class="wm">{d.wordmark || d.name}</span></div>
  ) : (
    <div class="prev"><Preview project={p} /></div>
  )}
  <div>
    <div class="pname">{d.name}</div>
    <div class="pdesc only-featured">{d.summary}</div>
  </div>
  {d.draft && <span class="draft-flag">Draft</span>}
</a>
