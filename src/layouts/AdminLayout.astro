---
import "../styles/global.css";
import "../styles/admin.css";
import { SCREENS, SOON } from "../admin/nav";

interface Props { title: string; email?: string; active?: string }
const { title, email, active } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{title} · Omoakins dashboard</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Space+Mono:wght@400;700&display=swap">
</head>
<body class="admin">
{email ? (
  <div class="a-shell">
    <aside class="a-side" id="side">
      <div class="a-side-top">
        <a class="brand" href="/admin/home">
          <span class="mark">O</span>
          <span class="name">Omoakins</span>
        </a>
        <button type="button" class="a-menu" id="sideToggle" aria-expanded="false" aria-controls="sideNav">Menu</button>
      </div>
      <nav class="a-side-nav" id="sideNav">
        <div class="a-side-label">Your site</div>
        {SCREENS.map((s) => (
          <a href={`/admin/${s.key}`} class:list={{ active: active === s.key }} aria-current={active === s.key ? "page" : undefined}>{s.label}</a>
        ))}
        <div class="a-side-label">Coming soon</div>
        {SOON.map((s) => <span class="a-side-soon">{s}</span>)}
        <div class="a-side-foot">
          <a href="/" target="_blank" rel="noopener">View live site ↗</a>
          <button type="button" class="a-link" id="signOut">Sign out</button>
          <span class="a-side-email">{email}</span>
        </div>
      </nav>
    </aside>
    <main class="a-main">
      <slot />
    </main>
  </div>
) : (
  <main class="a-solo"><slot /></main>
)}
<script>
  import { supabase } from "../lib/supabase-browser";
  document.getElementById("signOut")?.addEventListener("click", async () => {
    await supabase.auth.signOut();
    location.href = "/admin/login";
  });
  const toggle = document.getElementById("sideToggle");
  toggle?.addEventListener("click", () => {
    const open = document.getElementById("side")!.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>
</body>
</html>
