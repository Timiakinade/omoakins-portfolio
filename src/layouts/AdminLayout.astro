---
import "../styles/global.css";
import "../styles/admin.css";

interface Props { title: string; email?: string; wide?: boolean }
const { title, email, wide = false } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{title} · Omoakins dashboard</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Space+Mono:wght@400;700&display=swap">
</head>
<body class="admin">
<div class:list={["a-wrap", { wide }]}>
  <header class="a-top">
    <a class="brand" href="/admin">
      <span class="mark">O</span>
      <span class="name">Omoakins <span class="a-muted">· Dashboard</span></span>
    </a>
    {email && (
      <nav class="a-nav">
        <a href="/admin">Overview</a>
        <a href="/" target="_blank" rel="noopener">View live site ↗</a>
        <button type="button" class="a-link" id="signOut" title={`Signed in as ${email}`}>Sign out</button>
      </nav>
    )}
  </header>
  <main>
    <slot />
  </main>
</div>
<script>
  import { supabase } from "../lib/supabase-browser";
  document.getElementById("signOut")?.addEventListener("click", async () => {
    await supabase.auth.signOut();
    location.href = "/admin/login";
  });
</script>
</body>
</html>
