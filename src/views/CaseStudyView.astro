---
import Base from "../layouts/Base.astro";
import { shortName } from "../lib/content";
import type { Project, Site } from "../lib/schema";

interface Props { site: Site; hasPosts: boolean; preview?: boolean; project: Project; next: Project }
const { site, hasPosts, preview, project, next } = Astro.props;
const d = project.data;
const name = shortName(d.name);
---
<Base
  site={site}
  hasPosts={hasPosts}
  preview={preview}
  title={d.seo?.title || `${name} — Case Study · ${site.name}`}
  description={d.seo?.description || d.summary}
  og={`work/${project.id}`}
  ogImage={d.seo?.image}
  nav="work"
  type="article"
>
  <div class="cs-nav">
    <a class="cs-back" href="/work">← Work / {name}</a>
    <a class="btn" href="/contact">Book a call</a>
  </div>
  <div class="cs-title">
    <span class="k mono">{d.sector} · {d.category}</span>
    <h1 class="bebas">{name}</h1>
    <div class="cs-facts">
      {d.facts.map((f) => <div class="f"><div class="l">{f.label}</div><div class="v">{f.value}</div></div>)}
    </div>
  </div>
  <div class="cs-hero">
    {d.heroImage
      ? <img src={d.heroImage} alt={`${name} — hero visual`} />
      : <span class="hint">Hero visual — drop real screen here</span>}
  </div>
  {d.sections.map((s) =>
    s.type === "text" ? (
      <div class="cs-overview">
        <div class="lead"><h2 class="k">{s.heading}</h2>{s.body.map((para) => <p>{para}</p>)}</div>
        {s.side.length > 0 && (
          <div class="cs-side">
            {s.side.map((x) => <div><div class="l">{x.label}</div><div class="v">{x.value}</div></div>)}
          </div>
        )}
      </div>
    ) : s.type === "cards" ? (
      <div class="ca-row">
        {s.cards.map((c) => <div class="ca-card"><h2 class="l">{c.heading}</h2><p>{c.text}</p></div>)}
      </div>
    ) : s.type === "images" ? (
      <div class:list={["ca-row", { "cs-images": s.heading }]}>
        {s.heading && <h2 class="cs-images-h">{s.heading}</h2>}
        {s.images.some((img) => img.src) ? (
          <div class="cs-screens">
            {s.images.filter((img) => img.src).map((img) => (
              <figure>
                <img src={img.src} alt={img.alt} loading="lazy" />
                {img.caption && <figcaption>{img.caption}</figcaption>}
              </figure>
            ))}
          </div>
        ) : (
          <div class="cs-strip"><span class="hint">Screen sequence — 2–3 key flows</span></div>
        )}
      </div>
    ) : (
      <div class="cs-outcome">
        <div class="lead"><h2 class="k">{s.heading}</h2><p>{s.text}</p></div>
        <div class="cs-stat"><div class="big bebas">{s.value}</div><div class="cap">{s.caption}</div></div>
      </div>
    )
  )}
  <div class="cs-next">
    <div><div class="l">Next project</div><a class="n bebas" href={`/work/${next.id}`}>{shortName(next.data.name)} →</a></div>
    <a class="cs-back" href="/work">Back to all work</a>
  </div>
</Base>
