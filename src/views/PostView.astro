---
import Base from "../layouts/Base.astro";
import { formatDate, markdown } from "../lib/content";
import type { Post, Site } from "../lib/schema";

interface Props { site: Site; preview?: boolean; post: Post }
const { site, preview, post } = Astro.props;
const d = post.data;
---
<Base
  site={site}
  hasPosts={true}
  preview={preview}
  title={d.seo?.title || `${d.title} · ${site.name}`}
  description={d.seo?.description || d.description}
  og={`blog/${post.id}`}
  ogImage={d.seo?.image}
  nav="blog"
  type="article"
>
  <div class="cs-nav">
    <a class="cs-back" href="/blog">← Blog</a>
    <a class="btn" href="/contact">Book a call</a>
  </div>
  <article class="post">
    <header class="post-head">
      <time class="k mono" datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
      <h1 class="bebas">{d.title}</h1>
      <p class="post-lead">{d.description}</p>
    </header>
    {d.cover && <img class="post-cover" src={d.cover} alt="" />}
    <div class="prose" set:html={markdown(d.body)} />
  </article>
  <div class="cs-next">
    <a class="cs-back" href="/blog">Back to all posts</a>
    <a class="btn" href="/contact">Start a project</a>
  </div>
</Base>
