---
import Base from "../layouts/Base.astro";
import Tile from "../components/Tile.astro";
import Testimonials from "../components/Testimonials.astro";
import Band from "../components/Band.astro";
import type { Project, Site, Testimonial } from "../lib/schema";

interface Props { site: Site; hasPosts: boolean; preview?: boolean; projects: Project[]; testimonials: Testimonial[] }
const { site, hasPosts, preview, projects, testimonials } = Astro.props;
const home = site.home;
// The bento shows the first six; filtering (in site.ts) can bring any project in.
---
<Base site={site} hasPosts={hasPosts} preview={preview} og="home" nav="home">
  {site.home.layout.filter((l) => l.show).map(({ section }) =>
    section === "intro" ? (
      <Fragment>
      <div class="hero">
        <div>
          <div class="avail"><span class="pulse"></span><span class="mono">{home.availability}</span></div>
          <h1 class="bebas">{home.headline.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h1>
          <p>{home.intro}</p>
        </div>
        <div class="stats">
          {home.stats.map((s, i) => (
            <>
              {i > 0 && <div class="div"></div>}
              <div class="stat"><div class="num bebas">{s.value}</div><div class="lbl">{s.label}</div></div>
            </>
          ))}
        </div>
      </div>
      </Fragment>
    ) : section === "work" ? (
      <Fragment>
      <div class="filters" data-filters="bento" data-limit="6" data-feature-first>
        <button type="button" class="chip active" data-filter="all" aria-pressed="true">All work</button>
        {home.filters.map((c) => <button type="button" class="chip" data-filter={c} aria-pressed="false">{c}</button>)}
      </div>
      <div class="bento reveal" id="bento">
        {projects.map((p, i) => (
          <Tile project={p} featured={i === 0 && p.data.featured} hidden={i >= 6} />
        ))}
        <div class="empty" hidden={projects.length > 0}>No projects in this category yet.</div>
      </div>
      </Fragment>
    ) : section === "testimonials" ? (
      <Testimonials items={testimonials} label={home.testimonialsLabel} />
    ) : (
      <Band site={site} />
    )
  )}
</Base>
