---
import LandingView from "../views/LandingView.astro";
import { RESERVED_SLUGS, getPages, getPosts, getProjects, getSite, type Page } from "../lib/content";

export async function getStaticPaths() {
  // A landing page can't take a built-in page's address; the dashboard prevents this too.
  return (await getPages())
    .filter((page) => !RESERVED_SLUGS.includes(page.id))
    .map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props as { page: Page };
const [site, projects, posts] = await Promise.all([getSite(), getProjects(), getPosts()]);
---
<LandingView site={site} hasPosts={posts.length > 0} page={page} projects={projects} />
