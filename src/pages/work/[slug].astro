---
import CaseStudyView from "../../views/CaseStudyView.astro";
import { getPosts, getProjects, getSite, type Project } from "../../lib/content";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props as { project: Project; next: Project };
const [site, posts] = await Promise.all([getSite(), getPosts()]);
---
<CaseStudyView site={site} hasPosts={posts.length > 0} project={project} next={next} />
