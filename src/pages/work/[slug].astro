---
import Base from "../../layouts/Base.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import { getProjects, shortName, site, type Project } from "../../lib/content";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props as { project: Project; next: Project };
const d = project.data;
const name = shortName(d.name);
---
<Base
  title={d.seo?.title || `${name} — Case Study · ${site.name}`}
  description={d.seo?.description || d.summary}
  og={`work/${project.id}`}
  ogImage={d.seo?.image}
  nav="work"
  type="article"
>
  <Eyebrow step="03 · Case study" desc={`${d.sector} project`} />
  <div class="cs-nav">
    <a class="cs-back" href="/work">← Work / {name}</a>
    <a class="btn" href="/contact">Book a call</a>
  </div>
  {d.draft && <p class="draft-banner">Draft — only visible on local and preview builds.</p>}
  <div class="cs-title">
    <span class="k mono">{d.sector} · {d.category}</span>
    <h1 class="bebas">{name}</h1>
    <div class="cs-facts">
      <div class="f"><div class="l">Role</div><div class="v">{d.role}</div></div>
      <div class="f"><div class="l">Client</div><div class="v">{d.client}</div></div>
      <div class="f"><div class="l">Year</div><div class="v">{d.year}</div></div>
      <div class="f"><div class="l">Timeline</div><div class="v">{d.timeline}</div></div>
    </div>
  </div>
  <div class="cs-hero">
    {d.heroImage
      ? <img src={d.heroImage} alt={`${name} — hero visual`} />
      : <span class="hint">Hero visual — drop real screen here</span>}
  </div>
  <div class="cs-overview">
    <div class="lead"><h2 class="k">Overview</h2><p>{d.overview}</p></div>
    <div class="cs-side">
      <div><div class="l">Deliverables</div><div class="v">{d.deliverables}</div></div>
      <div><div class="l">Tools</div><div class="v">{d.tools}</div></div>
    </div>
  </div>
  <div class="ca-row">
    <div class="ca-card"><h2 class="l">The challenge</h2><p>{d.challenge}</p></div>
    <div class="ca-card"><h2 class="l">The approach</h2><p>{d.approach}</p></div>
  </div>
  <div class="ca-row">
    {d.screens.length > 0 ? (
      <div class="cs-screens">
        {d.screens.map((s) => <img src={s.src} alt={s.alt} loading="lazy" />)}
      </div>
    ) : (
      <div class="cs-strip"><span class="hint">Screen sequence — 2–3 key flows</span></div>
    )}
  </div>
  <div class="cs-outcome">
    <div class="lead"><h2 class="k">Outcome</h2><p>{d.outcome}</p></div>
    <div class="cs-stat"><div class="big bebas">{d.stat.value}</div><div class="cap">{d.stat.caption}</div></div>
  </div>
  <div class="cs-next">
    <div><div class="l">Next project</div><a class="n bebas" href={`/work/${next.id}`}>{shortName(next.data.name)} →</a></div>
    <a class="cs-back" href="/work">Back to all work</a>
  </div>
</Base>
