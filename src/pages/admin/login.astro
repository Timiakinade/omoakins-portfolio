---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
---
<AdminLayout title="Log in">
  <section class="a-login">
    <h1 class="bebas">Dashboard</h1>
    <form id="loginForm" class="a-card">
      <label class="a-label" for="email">Email</label>
      <input class="a-input" id="email" type="email" autocomplete="username" required>
      <label class="a-label" for="password">Password</label>
      <input class="a-input" id="password" type="password" autocomplete="current-password" required>
      <button class="a-btn primary" type="submit">Log in</button>
    </form>
    <p class="a-note" id="note" role="status"></p>
  </section>
</AdminLayout>

<script>
  import { supabase } from "../../lib/supabase-browser";

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const note = $("note");

  const go = () => {
    const next = new URLSearchParams(location.search).get("next");
    location.href = next && next.startsWith("/") && !next.startsWith("//") ? next : "/admin";
  };
  if (new URLSearchParams(location.search).has("denied")) {
    supabase.auth.signOut();
    note.textContent = "That account doesn't have access to this dashboard.";
  } else {
    supabase.auth.getUser().then(({ data }) => data.user && go());
  }

  $<HTMLFormElement>("loginForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    note.textContent = "Logging in…";
    const { error } = await supabase.auth.signInWithPassword({
      email: $<HTMLInputElement>("email").value.trim().toLowerCase(),
      password: $<HTMLInputElement>("password").value,
    });
    if (error) {
      note.textContent = /invalid/i.test(error.message)
        ? "That email and password don't match."
        : `Couldn't log in: ${error.message}`;
      return;
    }
    go();
  });
</script>
