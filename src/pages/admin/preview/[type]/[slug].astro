---
/* Full-screen preview inside the dashboard: the draft in the real design, with a way back. */
export const prerender = false;
import { ENTRY_TYPES, type EntryType } from "../../../../lib/schema";

const { type, slug } = Astro.params as { type: EntryType; slug: string };
if (!ENTRY_TYPES.includes(type)) return Astro.redirect("/admin/home");
const back = Astro.url.searchParams.get("back") ?? "/admin/home";
const safeBack = back.startsWith("/admin/") ? back : "/admin/home";
const page = Astro.url.searchParams.get("page");
const src = `/preview/${type}/${slug}${page ? `?page=${encodeURIComponent(page)}` : ""}`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Preview · Omoakins dashboard</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500&family=Space+Mono&display=swap">
<style>
  html, body { margin: 0; height: 100%; background: #0D0D0F; }
  body { display: flex; flex-direction: column; font-family: "DM Sans", system-ui, sans-serif; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 16px;
    background: #131316; border-bottom: 1px solid #26262A; }
  .back { display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 10px;
    background: #1B5E4A; color: #ECFDF5; font-size: 14px; font-weight: 500; text-decoration: none; }
  .back:hover { background: #216b55; }
  .note { font-family: "Space Mono", monospace; text-transform: uppercase; letter-spacing: 0.12em; font-size: 11px; color: #6EE7B7; }
  .sizes { display: flex; gap: 8px; }
  .sizes button { background: #0A0A0C; border: 1px solid #26262A; color: #9A9A94; border-radius: 999px; padding: 6px 12px;
    font: 12px "DM Sans", sans-serif; cursor: pointer; }
  .sizes button[aria-pressed="true"] { border-color: #6EE7B7; color: #F5F5F0; }
  .stage { flex: 1; display: flex; justify-content: center; overflow: hidden; background: #0A0A0C; }
  iframe { width: 100%; height: 100%; border: 0; background: #0D0D0F; transition: width .2s ease; }
  iframe.phone { width: 390px; border-left: 1px solid #26262A; border-right: 1px solid #26262A; }
  @media (max-width: 640px) { .sizes, .note { display: none; } }
</style>
</head>
<body>
  <div class="bar">
    <a class="back" href={safeBack}>← Back to editing</a>
    <span class="note">Preview — not live until you publish</span>
    <div class="sizes" role="group" aria-label="Screen size">
      <button type="button" data-size="desktop" aria-pressed="true">Computer</button>
      <button type="button" data-size="phone" aria-pressed="false">Phone</button>
    </div>
  </div>
  <div class="stage"><iframe id="frame" src={src} title="Preview of your draft"></iframe></div>
  <script>
    const frame = document.getElementById("frame")!;
    document.querySelectorAll<HTMLButtonElement>("[data-size]").forEach((b) =>
      b.addEventListener("click", () => {
        frame.classList.toggle("phone", b.dataset.size === "phone");
        document.querySelectorAll("[data-size]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      }),
    );
  </script>
</body>
</html>
