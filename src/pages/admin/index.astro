---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import { TYPE_LABELS, itemTitle, publicPath } from "../../admin/fields";
import type { EntryType } from "../../lib/schema";
import type { EntryRow } from "../../lib/supabase";

const { data, error } = await Astro.locals.supabase
  .from("entries")
  .select("type, slug, draft, published, updated_at");
if (error) throw error;
const rows = data as Pick<EntryRow, "type" | "slug" | "draft" | "published" | "updated_at">[];

const status = (r: (typeof rows)[number]) =>
  !r.published ? { cls: "draft", text: "Draft · not live" }
  : JSON.stringify(r.published) === JSON.stringify(r.draft) ? { cls: "live", text: "Live" }
  : { cls: "changed", text: "Live · changes not published" };

const sortKey = (r: (typeof rows)[number]) =>
  r.type === "post" ? -new Date(String(r.draft.date ?? 0)).valueOf() : Number(r.draft.order ?? 0);
const groups = (["project", "post", "page", "testimonial"] as EntryType[]).map((type) => ({
  type,
  rows: rows.filter((r) => r.type === type).sort((a, b) => sortKey(a) - sortKey(b) || a.slug.localeCompare(b.slug)),
}));
const settings = rows.find((r) => r.type === "settings");
const updated = (iso: string) => new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short" });
---
<AdminLayout title="Overview" email={Astro.locals.email}>
  <h1 class="a-title">Your site</h1>
  <p class="a-muted">Edit anything, preview it, then publish. Nothing changes on the live site until you press Publish.</p>

  <section class="a-section">
    <div class="a-section-head"><h2>Site settings</h2></div>
    <a class="a-row" href="/admin/edit/settings/site">
      <span class="a-row-title">Home, Work, Blog, About and Contact text · contact details · social links</span>
      {settings && <span class={`badge ${status(settings).cls}`}>{status(settings).text}</span>}
    </a>
  </section>

  {groups.map((g) => (
    <section class="a-section">
      <div class="a-section-head">
        <h2>{TYPE_LABELS[g.type].many}</h2>
        <a class="a-btn" href={`/admin/new/${g.type}`}>+ New {TYPE_LABELS[g.type].one.toLowerCase()}</a>
      </div>
      {g.rows.length === 0 ? (
        <p class="a-empty">None yet.</p>
      ) : (
        g.rows.map((r) => {
          const s = status(r);
          return (
            <a class="a-row" href={`/admin/edit/${r.type}/${r.slug}`}>
              <span class="a-row-title">{itemTitle(g.type, r.draft)}</span>
              <span class="a-row-meta">{g.type !== "testimonial" && publicPath(g.type, r.slug)} · edited {updated(r.updated_at)}</span>
              <span class={`badge ${s.cls}`}>{s.text}</span>
            </a>
          );
        })
      )}
    </section>
  ))}

  <section class="a-section">
    <div class="a-section-head"><h2>Coming next</h2></div>
    <div class="a-soon">
      <div class="a-card"><strong>Messages</strong><p class="a-muted">Contact-form messages will arrive here.</p></div>
      <div class="a-card"><strong>Visitors</strong><p class="a-muted">Page views, most-read case studies and where visitors come from.</p></div>
    </div>
  </section>
</AdminLayout>
