---
export const prerender = false;
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import Editor from "../../../../admin/Editor";
import { TYPE_LABELS, itemTitle } from "../../../../admin/fields";
import { SCREENS, screenFor } from "../../../../admin/nav";
import { ENTRY_TYPES, upgradeProjectData, type EntryType } from "../../../../lib/schema";

const { type, slug } = Astro.params as { type: EntryType; slug: string };
if (!ENTRY_TYPES.includes(type) || type === "settings") return Astro.redirect("/admin/home");
const db = Astro.locals.supabase;

const [{ data: row }, { data: others }] = await Promise.all([
  db.from("entries").select("draft, published").eq("type", type).eq("slug", slug).maybeSingle(),
  db.from("entries").select("type, slug, draft").in("type", ["project", "settings"]),
]);
const screen = SCREENS.find((s) => s.key === screenFor(type))!;
if (!row) return Astro.redirect(`/admin/${screen.key}`);

// Projects saved before case studies became flexible open in the new shape (both sides, so status compares fairly).
const draft = type === "project" ? upgradeProjectData(row.draft) : row.draft;
const published = type === "project" && row.published ? upgradeProjectData(row.published) : row.published;

const categories: string[] = others?.find((r) => r.type === "settings")?.draft.categories ?? [];
const projects = (others ?? [])
  .filter((r) => r.type === "project")
  .sort((a, b) => Number(a.draft.order) - Number(b.draft.order))
  .map((r) => ({ slug: r.slug, name: String(r.draft.name ?? r.slug) }));
---
<AdminLayout title={itemTitle(type, row.draft)} email={Astro.locals.email} active={screen.key}>
  <a class="a-back" href={`/admin/${screen.key}`}>← {screen.label}</a>
  <p class="a-kicker">{TYPE_LABELS[type].one}</p>
  <h1 class="a-title">{itemTitle(type, row.draft)}</h1>
  <Editor client:only="preact" type={type} slug={slug} draft={draft} published={published} categories={categories} projects={projects} />
</AdminLayout>
