---
/* One sidebar screen: a page's text (part of Site settings) and/or a list of items. */
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import Editor from "../../admin/Editor";
import { SCREENS } from "../../admin/nav";
import { SETTINGS_SCREENS, TYPE_LABELS, itemTitle, publicPath } from "../../admin/fields";
import { pick, status } from "../../admin/status";
import { siteSchema, type EntryType } from "../../lib/schema";
import type { EntryRow } from "../../lib/supabase";

const screen = SCREENS.find((s) => s.key === Astro.params.screen);
if (!screen) return Astro.redirect("/admin/home");

const { data, error } = await Astro.locals.supabase.from("entries").select("type, slug, draft, published, updated_at");
if (error) throw error;
const rows = data as Pick<EntryRow, "type" | "slug" | "draft" | "published" | "updated_at">[];

// Site settings, with defaults filled in for options added after it was last saved.
const settingsRow = rows.find((r) => r.type === "settings");
const normalise = (v: Record<string, unknown> | null) => {
  if (!v) return v;
  const parsed = siteSchema.safeParse(v);
  return parsed.success ? (parsed.data as Record<string, unknown>) : v;
};
const settingsDraft = normalise(settingsRow?.draft ?? null);
const settingsLive = normalise(settingsRow?.published ?? null);
const part = screen.settings ? SETTINGS_SCREENS[screen.settings] : null;

const listType = screen.list as EntryType | undefined;
const sortKey = (r: (typeof rows)[number]) =>
  r.type === "post" ? -new Date(String(r.draft.date ?? 0)).valueOf() : Number(r.draft.order ?? 0);
const items = listType ? rows.filter((r) => r.type === listType).sort((a, b) => sortKey(a) - sortKey(b) || a.slug.localeCompare(b.slug)) : [];
const updated = (iso: string) => new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short" });

const categories = (settingsDraft?.categories as string[]) ?? [];
const projects = rows
  .filter((r) => r.type === "project")
  .sort((a, b) => Number(a.draft.order) - Number(b.draft.order))
  .map((r) => ({ slug: r.slug, name: String(r.draft.name ?? r.slug) }));
---
<AdminLayout title={screen.label} email={Astro.locals.email} active={screen.key}>
  <h1 class="a-title">{screen.label}</h1>
  <p class="a-muted a-intro">{screen.intro}</p>

  {listType && (
    <section class="a-section">
      <div class="a-section-head">
        <h2>{TYPE_LABELS[listType].many}</h2>
        <a class="a-btn primary" href={`/admin/new/${listType}`}>+ New {TYPE_LABELS[listType].one.toLowerCase()}</a>
      </div>
      {items.length === 0 ? (
        <p class="a-empty">None yet.</p>
      ) : (
        items.map((r) => {
          const s = status(r.draft, r.published);
          return (
            <a class="a-row" href={`/admin/edit/${r.type}/${r.slug}`}>
              <span class="a-row-title">{itemTitle(listType, r.draft)}</span>
              <span class="a-row-meta">{listType !== "testimonial" && publicPath(listType, r.slug)} · edited {updated(r.updated_at)}</span>
              <span class={`badge ${s.cls}`}>{s.text}</span>
            </a>
          );
        })
      )}
    </section>
  )}

  {part && settingsDraft && (
    <section class="a-section">
      {listType && <div class="a-section-head"><h2>Page text</h2></div>}
      <Editor
        client:only="preact"
        type="settings"
        slug="site"
        draft={settingsDraft}
        published={settingsLive}
        fields={part.fields}
        keys={part.keys}
        previewPage={screen.preview}
        categories={categories}
        projects={projects}
      />
    </section>
  )}
</AdminLayout>
